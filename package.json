{
  "name": "swindowzig",
  "type": "module",
  "version": "0.2.0",
  "description": "A thin WebGPU wrapper in Zig for games: one fixed-tick loop on the web (wasm) and the desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "progress": "node scripts/progress.mjs",
    "build:wasm": "zig build web",
    "build:wasm:voxel": "zig build web -Dexample=voxel -Doptimize=ReleaseFast",
    "build:js": "bun build backends/wasm/boot.ts backends/wasm/chunk-worker.ts --outdir=zig-out/bin --minify",
    "build": "yarn build:wasm && yarn build:js",
    "build:voxel": "yarn build:wasm:voxel && yarn build:js",
    "dev": "yarn build && bun backends/wasm/dev-server.ts",
    "dev:voxel": "yarn build:voxel && bun backends/wasm/dev-server.ts --example voxel",
    "dev:watch": "bun --watch backends/wasm/dev-server.ts",
    "web:windows": "zig build web -Dexample=windows && bun build backends/wasm/boot.ts --outdir=zig-out/bin && bun backends/wasm/dev-server.ts",
    "native:windows": "zig build run -Dexample=windows",
    "native:voxel": "zig build run -Dexample=voxel -Doptimize=ReleaseFast --",
    "native:justabox": "zig build run -Dexample=justabox",
    "build:native": "zig build native",
    "test": "zig build test",
    "test:web": "bash test-web-build.sh",
    "test:workers": "bun test backends/wasm/worker-pool.test.ts",
    "test:browser": "playwright test -c backends/wasm/playwright.config.ts",
    "test:a11y": "yarn test:browser",
    "typecheck:web": "tsc --noEmit -p backends/wasm",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "requirements:check": "node requirements/check.mjs",
    "requirements:build": "node requirements/check.mjs --write",
    "labels": "bash scripts/labels.sh",
    "postinstall": "husky"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@commitlint/cli": "^20.5.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.3.5",
    "@webgpu/types": "^0.1.74",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
